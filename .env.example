# ------------------------------------------------------------------
# CarMaint – configuration
# Copy to ".env" and adjust:   cp .env.example .env
# ------------------------------------------------------------------

# Image version: latest (newest release), a fixed version such as 0.1.0,
# or edge (current development state of main)
CARMAINT_VERSION=latest

# App name (browser tab, login page)
APP_NAME=CarMaint

# Public URL where the website is reachable (without trailing "/")
APP_URL=http://localhost:8090

# Port on the host
PORT=8090

# Server time zone (logs, backups)
TZ=Europe/Zurich

# Default currency for new users: EUR, CHF or USD
DEFAULT_CURRENCY=CHF

# The UI uses the browser language (de, en, es or fr). DEFAULT_LANGUAGE is only
# used for other browser languages: de, en, es or fr. Users can switch anytime.
DEFAULT_LANGUAGE=en

# --- Uploads -------------------------------------------------------
# Max. size per photo or receipt in MB (1–30). Images are shrunk in the
# browser before uploading, so this mainly applies to PDFs.
MAX_FILE_SIZE_MB=20
# Max. storage per user for photos and receipts in MB (0 = unlimited)
USER_STORAGE_LIMIT_MB=0
# Allowed file types for uploads, comma-separated:
# pdf, jpg, png
# Car photos only take the image types (jpg if none is listed).
ALLOWED_FILE_TYPES=pdf,jpg

# --- First user = admin --------------------------------------------
# Only created on startup if NO user exists yet.
# Password: at least 8 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Forgot the password? Set to true, change ADMIN_PASSWORD, restart the
# container – then make sure to set it back to false.
ADMIN_RESET_PASSWORD=false

# --- Demo user (optional) -----------------------------------------
# Username of a demo account (normal user). Leave empty = no demo.
DEMO_USERNAME=
# Password of the demo account (min. 8 characters). If set, the demo user is
# created on startup when it does not exist yet. Leave empty = create it manually.
DEMO_PASSWORD=
# Settings disabled for the demo user, comma-separated (none = all enabled):
# language, currency, infobox, export, import, password
DEMO_DISABLED=password

# --- PocketBase admin UI (optional) --------------------------------
# Access to the database UI at APP_URL/_/
# Password: at least 10 characters. Leave empty = no account is created.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# --- Security (optional) -------------------------------------------
# Exactly 32 characters. Encrypts the server settings in the database.
# Generate e.g. with:  openssl rand -hex 16
# Warning: once set, never change or lose it!
PB_ENCRYPTION_KEY=

# Behind a reverse proxy (nginx, Traefik, Caddy, Nginx Proxy Manager),
# so the login rate limit sees the real client IP. E.g.: X-Forwarded-For
TRUSTED_PROXY_HEADERS=
