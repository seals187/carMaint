# ------------------------------------------------------------------
# CarMaint – Konfiguration
# Kopieren nach ".env" und anpassen:   cp .env.example .env
# ------------------------------------------------------------------

# Name der App (Browser-Tab, Login-Seite)
APP_NAME=CarMaint

# Öffentliche Adresse, unter der die Website erreichbar ist (ohne "/" am Ende)
APP_URL=http://localhost:8090

# Port auf dem Host
PORT=8090

# Zeitzone des Servers (Logs, Backups)
TZ=Europe/Zurich

# Standardwährung für neue Benutzer: EUR, CHF oder USD
DEFAULT_CURRENCY=CHF

# --- Erster Benutzer = Admin ---------------------------------------
# Wird beim Start nur angelegt, wenn noch KEIN Benutzer existiert.
# Passwort: mindestens 8 Zeichen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-aendern

# Passwort vergessen? Auf true setzen, ADMIN_PASSWORD anpassen, Container
# neu starten – danach unbedingt wieder auf false stellen.
ADMIN_RESET_PASSWORD=false

# --- PocketBase-Verwaltung (optional) ------------------------------
# Zugang zur Datenbank-Oberfläche unter APP_URL/_/
# Passwort: mindestens 10 Zeichen. Leer lassen = kein automatisches Konto.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# --- Sicherheit (optional) -----------------------------------------
# Genau 32 Zeichen. Verschlüsselt die Server-Einstellungen in der Datenbank.
# Erzeugen z. B. mit:  openssl rand -hex 16
# Achtung: Einmal gesetzt, nicht mehr ändern oder verlieren!
PB_ENCRYPTION_KEY=

# Hinter einem Reverse Proxy (nginx, Traefik, Caddy, Nginx Proxy Manager),
# damit die Login-Sperre die echte Client-IP sieht. Z. B.: X-Forwarded-For
TRUSTED_PROXY_HEADERS=
